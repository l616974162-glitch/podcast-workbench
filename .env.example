# 复制为 .env 后填写；不要将真实密钥提交到 Git 或发到聊天里。
# 模型名按 2026-10-24 官方文档设置，可按账户可用模型修改。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 下列地址对应阿里百炼北京地域，必须使用对应地域的密钥。
DASHSCOPE_API_KEY=
QWEN_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_TTS_MODEL=qwen3-tts-flash

# 留空时先查找系统 PATH，再使用 imageio-ffmpeg 随包版本。
# 也可填写本机 ffmpeg.exe 的绝对路径；显式配置错误时不会静默回退。
FFMPEG_PATH=
